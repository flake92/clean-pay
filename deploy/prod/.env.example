# Keep one NAME=value assignment per line. Inline comments, interpolation,
# multiline values, and duplicate names are intentionally rejected.
COMPOSE_PROJECT_NAME=clean-pay-prod
# Minimum free disk space required before Docker image builds (8 GiB).
CLEAN_PAY_MIN_FREE_DISK_MB=8192
CLEAN_PAY_IMAGE=clean-pay-prod-app:local
CLEAN_PAY_BIND=127.0.0.1
CLEAN_PAY_PORT=4000
CLEAN_PAY_EDGE_NETWORK=remnawave-network

POSTGRES_DB=clean_pay
POSTGRES_USER=clean_pay
POSTGRES_PASSWORD=change-me-postgres-password

DATABASE_URL=postgresql://clean_pay:change-me-postgres-password@postgres:5432/clean_pay?schema=public
REDIS_URL=redis://redis:6379/0

APP_URL=https://pay.example.com
NEXT_PUBLIC_APP_URL=https://pay.example.com
NEXT_PUBLIC_BRAND_NAME=Clean Pay
NEXT_PUBLIC_BRAND_LOGO_URL=/clean-pay-logo.png
LOG_LEVEL=info
AUTH_STATE_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=90
AUDIT_INFO_RETENTION_DAYS=180
AUDIT_SECURITY_RETENTION_DAYS=365
RATE_LIMIT_RETENTION_DAYS=30
DATA_RETENTION_INTERVAL_SECONDS=21600

REMNASHOP_API_BASE_URL=https://bot.example.com/api/v1/public
# Optional override. When empty, /api/v1/admin is derived from the public base URL.
REMNASHOP_ADMIN_API_BASE_URL=https://bot.example.com/api/v1/admin
REMNASHOP_API_KEY=change-me-remnashop-app-api-key
REMNASHOP_AUTH_SERVICE_KEY=change-me-dedicated-remnashop-auth-service-key

# deploy.sh uses these containers to safely finish payment rollout.
REMNASHOP_API_CONTAINER=remnashop
REMNASHOP_WORKER_CONTAINER=remnashop-taskiq-worker
REMNASHOP_SCHEDULER_CONTAINER=remnashop-taskiq-scheduler
REMNASHOP_POSTGRES_CONTAINER=remnashop-db
REMNASHOP_MINIMUM_ALEMBIC_REVISION=0052

# deploy.sh enables the required Compose profile and monitors its heartbeat.
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_SECRET=change-me-long-random-payment-reconciliation-secret
PAYMENT_RECONCILIATION_BATCH_SIZE=10
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=30
PAYMENT_RECONCILIATION_INTERNAL_URL=http://app:4000/api/internal/payments/reconcile
REMNAWAVE_API_BASE_URL=https://panel.example.com
REMNAWAVE_TOKEN=change-me
# Comma-separated exact public HTTPS origins returned in subscription links.
REMNAWAVE_SUBSCRIPTION_ORIGINS=https://sub.example.com

WEB_JWT_SECRET=change-me-long-random-web-jwt-secret
WEB_REFRESH_SECRET=change-me-long-random-web-refresh-secret
AUDIT_IP_HASH_SECRET=change-me-long-random-audit-secret
# Caddy is the single trusted hop in the documented deployment.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_IDENTITY_SECRET=change-me-long-random-rate-limit-secret
AUTH_RATE_LIMIT_CAPACITY=1000
AUTH_CONCURRENCY_LIMIT=64
READINESS_INTERNAL_SECRET=change-me-long-random-readiness-secret
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

TELEGRAM_OIDC_CLIENT_ID=1234567890
TELEGRAM_OIDC_CLIENT_SECRET=change-me
TELEGRAM_BOT_TOKEN=1234567890:change-me

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

SUPPORT_ENABLED=false
SUPPORT_EMAIL=
SUPPORT_TELEGRAM_USERNAME=
SUPPORT_FAQ_URL=

# Optional authenticated Chatwoot widget. Configure all three values together.
# Keep CHATWOOT_HMAC_TOKEN secret; it is used only by the Clean Pay server.
CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_HMAC_TOKEN=

CLEAN_PAY_READINESS_MAILPIT_URL=
CLEAN_PAY_READINESS_REMNAWAVE_URL=
