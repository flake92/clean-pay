# This is the authoritative deploy input. Production entry points validate it
# as an owner-only regular file and derive separate .env.<role> files; Compose
# never injects this whole bundle into a narrow worker.
# Keep one NAME=value assignment per line. Inline comments, interpolation,
# multiline values, and duplicate names are intentionally rejected.
COMPOSE_PROJECT_NAME=clean-pay-prod
# Minimum free disk space required before Docker images are prepared (8 GiB).
CLEAN_PAY_MIN_FREE_DISK_MB=8192
CLEAN_PAY_DEPLOY_SOURCE=build
CLEAN_PAY_IMAGE=clean-pay-prod-app:local
CLEAN_PAY_MIGRATION_IMAGE=clean-pay-prod-migration:local
# Image provenance labels. Replace both for traceable server-side builds.
CLEAN_PAY_RELEASE=local
CLEAN_PAY_REVISION=local
CLEAN_PAY_BIND=127.0.0.1
CLEAN_PAY_PORT=4000
CLEAN_PAY_EDGE_NETWORK=remnawave-network

POSTGRES_DB=clean_pay
POSTGRES_USER=clean_pay_bootstrap
POSTGRES_PASSWORD=change-me-bootstrap-database-password

# Five pairwise-distinct identities. POSTGRES_* is the bootstrap superuser and
# is materialized only for PostgreSQL plus the stopped-maintenance provisioner.
DATABASE_URL=postgresql://clean_pay_app:change-me-application-database-password@postgres:5432/clean_pay?schema=public
MIGRATION_DATABASE_URL=postgresql://clean_pay_migration:change-me-migration-database-password@postgres:5432/clean_pay?schema=public
RETENTION_DATABASE_URL=postgresql://clean_pay_retention:change-me-retention-database-password@postgres:5432/clean_pay?schema=public
HOLD_OPERATOR_DATABASE_URL=postgresql://clean_pay_hold:change-me-hold-database-password@postgres:5432/clean_pay?schema=public
# Set both to true only for the first least-privilege adoption of a populated
# legacy volume, after a verified backup and while every runtime is stopped.
CLEAN_PAY_DATABASE_ADOPT_EXISTING=false
CLEAN_PAY_DATABASE_ADOPTION_BACKUP_CONFIRMED=false
# Effective PrismaPg/pg budgets for the application role.
DATABASE_POOL_MAX=8
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
REDIS_URL=redis://redis:6379/0

APP_URL=https://pay.example.com
NEXT_PUBLIC_APP_URL=https://pay.example.com
NEXT_PUBLIC_BRAND_NAME=Clean Pay
NEXT_PUBLIC_BRAND_LOGO_URL=/clean-pay-logo.png
LOG_LEVEL=info
AUTH_STATE_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=90
AUDIT_INFO_RETENTION_DAYS=180
AUDIT_SECURITY_RETENTION_DAYS=365
RATE_LIMIT_RETENTION_DAYS=30
# Terminal payment rows retain ledger fields; only URL/provider snapshots are scrubbed.
PAYMENT_SENSITIVE_RETENTION_DAYS=30
PAYMENT_OPERATION_SNAPSHOT_RETENTION_DAYS=90
PAYMENT_HOLD_DISPOSED_RETENTION_DAYS=365
DATA_RETENTION_INTERVAL_SECONDS=21600
# The retention worker has a separate, smaller pool and a longer cleanup budget.
RETENTION_DATABASE_POOL_MAX=2
RETENTION_DATABASE_CONNECTION_TIMEOUT_MS=5000
RETENTION_DATABASE_IDLE_TIMEOUT_MS=30000
RETENTION_DATABASE_QUERY_TIMEOUT_MS=120000
RETENTION_DATABASE_STATEMENT_TIMEOUT_MS=120000
RETENTION_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
RETENTION_DATABASE_LOCK_TIMEOUT_MS=30000

REMNASHOP_API_BASE_URL=https://bot.example.com/api/v1/public
# Optional override. When empty, /api/v1/admin is derived from the public base URL.
REMNASHOP_ADMIN_API_BASE_URL=https://bot.example.com/api/v1/admin
REMNASHOP_API_KEY=change-me-remnashop-app-api-key
REMNASHOP_AUTH_SERVICE_KEY=change-me-dedicated-remnashop-auth-service-key

# deploy.sh uses these containers to safely finish payment rollout.
REMNASHOP_API_CONTAINER=remnashop
REMNASHOP_WORKER_CONTAINER=remnashop-taskiq-worker
REMNASHOP_SCHEDULER_CONTAINER=remnashop-taskiq-scheduler
REMNASHOP_POSTGRES_CONTAINER=remnashop-db
REMNASHOP_MINIMUM_ALEMBIC_REVISION=0058
# Host path checked before any Remnashop rollout Docker access. The parent
# directory must be 0700/0750 and the regular non-symlink file 0400/0600.
REMNASHOP_ENV_FILE=/opt/remnashop/.env
REMNASHOP_ENV_EXPECTED_UID=0
REMNASHOP_ENV_EXPECTED_GID=0

# deploy.sh enables the required Compose profile and monitors its heartbeat.
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_SECRET=change-me-long-random-payment-reconciliation-secret
PAYMENT_RECONCILIATION_BATCH_SIZE=10
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=30
PAYMENT_RECONCILIATION_INTERNAL_URL=http://app:4000/api/internal/payments/reconcile
# Exact public HTTPS origins accepted from Remnashop payment responses.
PAYMENT_REDIRECT_ORIGINS=https://yoomoney.ru,https://pay.platega.io
REMNAWAVE_API_BASE_URL=https://panel.example.com
REMNAWAVE_TOKEN=change-me
# Comma-separated exact public HTTPS origins returned in subscription links.
REMNAWAVE_SUBSCRIPTION_ORIGINS=https://sub.example.com

WEB_JWT_SECRET=change-me-long-random-web-jwt-secret
# Versioned encryption write key. Prefer changing both id and secret during
# rotation. If an incident requires reusing the id, the old secret may appear
# once under that same id in the previous-key object; the v2 commitment keeps
# the two secrets unambiguous until rewrap usage reaches zero.
WEB_REFRESH_KEY_ID=primary
WEB_REFRESH_SECRET=change-me-long-random-web-refresh-secret
# WEB_REFRESH_PREVIOUS_KEYS={"previous-key-id":"previous-secret-at-least-32-characters"}
AUDIT_IP_HASH_SECRET=change-me-long-random-audit-secret
# Caddy is the single trusted hop in the documented deployment.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_IDENTITY_SECRET=change-me-long-random-rate-limit-secret
AUTH_RATE_LIMIT_CAPACITY=1000
AUTH_CONCURRENCY_LIMIT=64
READINESS_INTERNAL_SECRET=change-me-long-random-readiness-secret
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

TELEGRAM_OIDC_CLIENT_ID=1234567890
TELEGRAM_OIDC_CLIENT_SECRET=change-me
TELEGRAM_BOT_TOKEN=1234567890:change-me

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

SUPPORT_ENABLED=false
SUPPORT_EMAIL=
SUPPORT_TELEGRAM_USERNAME=
SUPPORT_FAQ_URL=

# Optional authenticated Chatwoot widget. Configure all three values together.
# Keep CHATWOOT_HMAC_TOKEN secret; it is used only by the Clean Pay server.
CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_HMAC_TOKEN=

CLEAN_PAY_READINESS_MAILPIT_URL=
CLEAN_PAY_READINESS_REMNAWAVE_URL=
